# Copy to `.env` and fill in. NEVER commit the real .env.
# These are read from the environment only — never from config files.

# ---- Global switches (override config/default.yaml) ----
# SAPPHIRE_EXEC_MODE=paper          # paper | live
# SAPPHIRE_ALLOW_LIVE=false         # must ALSO be true for any live order
# SAPPHIRE_DEFAULT_VENUE=hyperliquid
# SAPPHIRE_POLL_INTERVAL_S=15

# ---- Hyperliquid (live) ----
# Use an API wallet (agent wallet), not your main key. Start on testnet.
# HYPERLIQUID_ACCOUNT_ADDRESS=0xYourAccountAddress
# HYPERLIQUID_SECRET_KEY=0xYourApiWalletPrivateKey

# ---- Lighter (live — not yet wired) ----
# LIGHTER_API_KEY_PRIVATE_KEY=
# LIGHTER_ACCOUNT_INDEX=
# LIGHTER_API_KEY_INDEX=

# ---- Robinhood Agentic ----
# Robinhood is reached via its MCP endpoint (agent.robinhood.com/mcp/trading)
# and authenticates through Robinhood's own flow on a desktop device — this
# process does not hold Robinhood credentials. Equities only today; no perps.
